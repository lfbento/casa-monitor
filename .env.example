# ====== Conexão com o Miloco (captura de vídeo) ======
MILOCO_BASE_URL=https://localhost:8010
MILOCO_VERIFY_SSL=false          # certificado autoassinado
MILOCO_USERNAME=admin
MILOCO_LOGIN_CODE=
# Alternativa de teste: token JWT direto (sobrepõe o login)
MILOCO_TOKEN=
MILOCO_CAMERA_ID=                # vazio = primeira câmera da lista
MILOCO_CHANNEL=0

# ====== Modelos ======
DETECT_MODEL=yolo11n.pt
DETECT_FPS=10                    # amostragem do stream de 25 FPS
DETECT_CONF=0.35

# VLM / LLM (OpenAI-compatible) — MiMo (TencentDB) por padrão
VLM_BASE_URL=http://localhost:8421/v1
VLM_API_KEY=
VLM_MODEL=mimo-v2.6-pro
LLM_BASE_URL=http://localhost:8421/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.6-pro

# ====== Regras de negócio ======
LOITERING_SECONDS=30
VEHICLE_STOP_SECONDS=20
GATE_DWELL_SECONDS=5
NIGHT_WINDOW=00:00-05:30
SNAPSHOT_RETENTION_DAYS=7

# ====== Entrega do relatório ======
NOTIFY_CHANNEL=telegram          # telegram | whatsapp_evolution | email | none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_EVOLUTION_URL=
WHATSAPP_EVOLUTION_KEY=
WHATSAPP_EVOLUTION_INSTANCE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
