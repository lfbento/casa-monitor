# ====== Conexão com o Miloco (captura de vídeo) ======
MILOCO_BASE_URL=https://localhost:8010
MILOCO_VERIFY_SSL=false          # certificado autoassinado
MILOCO_USERNAME=admin
MILOCO_LOGIN_CODE=
# Alternativa de teste: token JWT direto (sobrepõe o login)
MILOCO_TOKEN=
MILOCO_CAMERA_ID=                # vazio = primeira câmera da lista
MILOCO_CHANNEL=0

# ====== Modelos ======
DETECT_MODEL=yolo11n.pt
DETECT_FPS=10                    # amostragem do stream de 25 FPS
DETECT_CONF=0.35

# VLM / LLM (OpenAI-compatible) — MiMo (TencentDB) por padrão
VLM_BASE_URL=http://localhost:8421/v1
VLM_API_KEY=
VLM_MODEL=mimo-v2.6-pro
LLM_BASE_URL=http://localhost:8421/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.6-pro

# ====== Regras de negócio ======
LOITERING_SECONDS=30
VEHICLE_STOP_SECONDS=20
GATE_DWELL_SECONDS=5
NIGHT_WINDOW=00:00-05:30
SNAPSHOT_RETENTION_DAYS=7
MATCH_THRESHOLD=0.95               # similaridade mínima do recorte (cosseno)
MATCH_MARGIN=0.05                  # separação mínima sobre a 2a melhor correspondência
HOUSE_SESSION_STALE_HOURS=24       # sem confirmação por isso → sessão antiga (STALE)
REPORT_LLM_MAX_CHARS=80000         # orçamento de entrada do LLM (caracteres)

# ====== Frescor do frame, fila de análise e latência do alerta ======
MAX_FRAME_AGE_SECONDS=2.0          # frame mais velho que isso é descartado
ALERT_MAX_LATENCY_SECONDS=5.0      # acima disso o alerta marca atraso e loga violação
ANALYSIS_QUEUE_MAX=8               # itens na fila de análise (descarta o mais antigo)
ANALYSIS_MAX_AGE_SECONDS=180       # item mais velho que isso não é analisado
ANALYSIS_DEDUP_SECONDS=60          # uma análise por (track, tipo) nessa janela
ANALYSIS_MIN_AREA_PX=2500          # área mínima da bbox para enfileirar análise
ANALYSIS_MIN_CONF=0.5              # confiança mínima da detecção para análise
ANALYSIS_TIMEOUT_SECONDS=30        # timeout da chamada ao provedor de análise

# ====== Entrega do relatório ======
NOTIFY_CHANNEL=telegram          # telegram | whatsapp_evolution | email | none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_EVOLUTION_URL=
WHATSAPP_EVOLUTION_KEY=
WHATSAPP_EVOLUTION_INSTANCE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
